<?xml version="1.0" encoding="utf-8"?>
<!-- PDF / Excel / Text report buttons, shared by the chart and compare screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <Button
        android:id="@+id/btnReportPdf"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:backgroundTint="#2D2B1E"
        android:text="📄 PDF"
        android:textAllCaps="false"
        android:textColor="#FFCA28"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnReportExcel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:backgroundTint="#1B3326"
        android:text="📗 Excel"
        android:textAllCaps="false"
        android:textColor="#66BB6A"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnReportText"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:backgroundTint="#2A2E39"
        android:text="📝 Text"
        android:textAllCaps="false"
        android:textColor="#B2B5BE"
        android:textSize="12sp" />
</LinearLayout>
