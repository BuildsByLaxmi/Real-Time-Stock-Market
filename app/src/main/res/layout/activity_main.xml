<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131722"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header Bar: Title, User Profile Greeting & Logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈 StockPro"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back, Trader! 👋"
                        android:textColor="#787B86"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E382B"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● MARKET OPEN"
                    android:textColor="#26A69A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#2A2E39"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textColor="#EF5350"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2. Indices Ticker (NIFTY 50 / SENSEX) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#1E222D"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#2A2E39"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIFTY 50"
                            android:textColor="#787B86"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvNiftyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24,140.20"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.45% ▲"
                            android:textColor="#26A69A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#1E222D"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#2A2E39"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SENSEX"
                            android:textColor="#787B86"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSensexPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="79,480.10"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.52% ▲"
                            android:textColor="#26A69A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Auto-Refresh Status Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvAutoRefreshStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏱️ Auto-Refresh: ON (Every 20s)"
                    android:textColor="#26A69A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnToggleRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Toggle]"
                    android:textColor="#2962FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etSearchStock"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#1E222D"
                    android:hint="Search stock (e.g. TCS, AAPL, INFY)..."
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#787B86"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#2962FF"
                    android:text="Search"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 4. Featured Stock Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E222D"
                app:cardCornerRadius="12dp"
                app:strokeColor="#2A2E39"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStockSymbol"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TCS (NSE)"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAddToWatchlist"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#2A2E39"
                            android:text="⭐ Watchlist"
                            android:textAllCaps="false"
                            android:textColor="#D1D4DC"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCompanyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tata Consultancy Services Ltd"
                        android:textColor="#787B86"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvStockPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹4,120.50"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStockChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="#1E382B"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="+3.99% ▲"
                            android:textColor="#26A69A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2A2E39"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvDayHigh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day High: ₹4,150.00" android:textColor="#9DB2C6" android:textSize="11sp" />
                            <TextView android:id="@+id/tvDayLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day Low: ₹3,970.00" android:textColor="#9DB2C6" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tv52High" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="52W High: ₹4,250.00" android:textColor="#9DB2C6" android:textSize="11sp" />
                            <TextView android:id="@+id/tvPeRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P/E Ratio: 31.4" android:textColor="#9DB2C6" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Feature Action Buttons -->
                    <Button
                        android:id="@+id/btnOpenWebChart"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#2A2E39"
                        android:text="🌐 Open Live Web Chart"
                        android:textAllCaps="false"
                        android:textColor="#2962FF"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnOpenCompare"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="#1A335C"
                            android:text="⚖️ Compare"
                            android:textAllCaps="false"
                            android:textColor="#70A8FF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnExportPdf"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="#2D2B1E"
                            android:text="📄 PDF Report"
                            android:textAllCaps="false"
                            android:textColor="#FFCA28"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Top Movers (Gainers & Losers) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Top Movers"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Top Gainers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGainers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#1E222D"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#2A2E39"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top Gainers"
                            android:textColor="#26A69A"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <TextView android:id="@+id/tvMoverAapl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AAPL  $225.80 (+5.2%)" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingVertical="2dp" />
                        <TextView android:id="@+id/tvMoverTcs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TCS  ₹4,120.50 (+3.9%)" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingVertical="2dp" />
                        <TextView android:id="@+id/tvMoverReliance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RELIANCE (+1.5%)" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingVertical="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Top Losers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLosers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#1E222D"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#2A2E39"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top Losers"
                            android:textColor="#EF5350"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <TextView android:id="@+id/tvMoverMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="META  $565.40 (-3.0%)" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingVertical="2dp" />
                        <TextView android:id="@+id/tvMoverWipro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIPRO  ₹540.10 (-2.0%)" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingVertical="2dp" />
                        <TextView android:id="@+id/tvMoverInfy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INFY  ₹1,880.20 (-1.2%)" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingVertical="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 6. Watchlist Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ My Watchlist"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E222D"
                app:cardCornerRadius="10dp"
                app:strokeColor="#2A2E39"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/llWatchlistContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/rowWatchlistInfy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="INFY (Infosys Ltd)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹1,880.20"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-1.18% ▼"
                            android:textColor="#EF5350"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2A2E39"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:id="@+id/rowWatchlistReliance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RELIANCE"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹2,950.00"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1.55% ▲"
                            android:textColor="#26A69A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
